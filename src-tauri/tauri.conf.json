{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Downloader",
  "version": "0.1.0",
  "identifier": "local.video-downloader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Video Downloader",
        "width": 1100,
        "height": 760,
        "minWidth": 520,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/install-media-tools.ps1",
      "resources/vendor/ffmpeg/ffmpeg-win64-lgpl.zip"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
