{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Downloader",
  "version": "0.1.3",
  "identifier": "local.video-downloader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Video Downloader",
        "width": 1100,
        "height": 760,
        "minWidth": 520,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/install-media-tools.ps1",
      "resources/vendor/ffmpeg/ffmpeg-win64-lgpl.zip"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5M0NBNERBNEJDNUU5REMKUldUYzZjVkwycVE4dWVTMjIwUXlNTjkrenN4MFRmN3ZCVklveTlEbE43YUd2ZDE4T2hLZWhiSWcK",
      "endpoints": [
        "https://github.com/shenhaofang/video_downloader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
